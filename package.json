{
  "name": "bilitato",
  "version": "1.6.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:release": "npm run build:vendor:realtime && node scripts/build-release.js",
    "build:firefox": "npm run build:vendor:realtime && node scripts/build-release.js --target=firefox",
    "build:firefox:source": "node scripts/build-firefox-source.js",
    "build:vendor:realtime": "esbuild scripts/remoteConfigRealtimeSource.js --bundle --format=esm --platform=browser --target=chrome116,firefox115 --outfile=vendor/remoteConfigRealtime.js",
    "commitlint": "commitlint --from HEAD~1 --to HEAD --verbose",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@supabase/realtime-js": "2.111.0",
    "esbuild": "0.28.1",
    "fflate": "^0.8.2",
    "husky": "^9.1.7",
    "supabase": "^2.113.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2"
  }
}
